<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.modeldesk.refresh</string>
  <key>ProgramArguments</key>
  <array><string>{{UV}}</string><string>run</string><string>{{REPO}}/refresh.py</string></array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>{{PATH}}</string></dict>
  <!-- 06:00 local time. launchd runs a missed job when the Mac next wakes. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>{{HOME}}/refresh.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/refresh.log</string>
</dict>
</plist>
